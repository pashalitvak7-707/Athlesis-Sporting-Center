<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Athlesis Sporting Center | Gym in Agios Tychonas, Limassol</title>
<meta name="description" content="Athlesis Sporting Center — Limassol's sporting center for gym, CrossFit, group classes and personal training. Since 2011.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --orange: #E85A2A;
    --orange-dark: #c84a1f;
    --black: #0a0a0a;
    --dark: #181818;
    --gray-900: #242424;
    --gray-700: #3a3a3a;
    --gray-500: #888;
    --gray-300: #c4c4c4;
    --white: #ffffff;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', system-ui, sans-serif;
    color: var(--white);
    background: var(--black);
    line-height: 1.5;
    overflow-x: hidden;
  }

  .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  h1, h2, h3, h4 {
    font-family: 'Bebas Neue', 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.95;
    font-weight: 400;
  }

  a { color: inherit; text-decoration: none; }

  /* TOP BAR */
  .topbar {
    background: var(--orange);
    color: var(--white);
    font-size: 12px;
    font-weight: 600;
    padding: 8px 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .topbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .topbar-left, .topbar-right { display: flex; gap: 20px; align-items: center; }

  /* LANGUAGE TOGGLE */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    background: rgba(0,0,0,0.25);
    border-radius: 100px;
    padding: 3px;
    gap: 0;
  }
  .lang-btn {
    background: transparent;
    color: var(--white);
    border: none;
    padding: 4px 12px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 100px;
    transition: all 0.2s;
  }
  .lang-btn.active {
    background: var(--white);
    color: var(--orange);
  }

  /* NAV */
  nav.navbar {
    background: var(--black);
    border-bottom: 1px solid var(--gray-900);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .brand-logo-img {
    height: 60px;
    width: auto;
    display: block;
  }
  .brand-fallback {
    line-height: 1.1;
  }
  .brand-fallback .name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    color: var(--orange);
    letter-spacing: 0.02em;
    display: block;
  }
  .brand-fallback .sub {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--white);
    display: block;
  }
  .nav-menu {
    display: flex;
    gap: 36px;
    align-items: center;
    list-style: none;
  }
  .nav-menu a {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--white);
    transition: color 0.2s;
    position: relative;
  }
  .nav-menu a:not(.btn-join):hover { color: var(--orange); }
  .nav-menu a:not(.btn-join)::after {
    content: '';
    position: absolute;
    bottom: -8px; left: 0;
    width: 0; height: 2px;
    background: var(--orange);
    transition: width 0.3s ease;
  }
  .nav-menu a:not(.btn-join):hover::after { width: 100%; }
  .btn-join {
    background: var(--orange);
    color: var(--white) !important;
    padding: 12px 24px;
    transition: background 0.2s;
  }
  .btn-join:hover { background: var(--orange-dark); }
  .btn-join::after { display: none !important; }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .menu-toggle span {
    display: block;
    width: 26px;
    height: 3px;
    background: var(--white);
    margin: 5px 0;
  }

  /* HERO */
  .hero {
    min-height: 90vh;
    background: var(--black);
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
  }
  .hero-content {
    padding: 80px 60px 80px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: max(24px, calc((100vw - 1280px) / 2 + 24px));
    position: relative;
    z-index: 2;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    width: fit-content;
  }
  .hero-tag::before {
    content: '';
    width: 40px;
    height: 2px;
    background: var(--orange);
  }
  .hero-tag span {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--orange);
  }
  .hero h1 {
    font-size: clamp(44px, 6vw, 96px);
    line-height: 0.95;
    margin-bottom: 24px;
    letter-spacing: -0.005em;
  }
  .hero h1 .orange { color: var(--orange); }
  .hero h1 .stroke {
    color: transparent;
    -webkit-text-stroke: 2px var(--white);
  }
  .hero-sub {
    font-size: 18px;
    color: var(--gray-300);
    margin-bottom: 40px;
    max-width: 480px;
    font-weight: 400;
  }
  .hero-buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: all 0.2s;
    cursor: pointer;
    border: 2px solid transparent;
  }
  .btn svg { width: 14px; height: 14px; }
  .btn-primary {
    background: var(--orange);
    color: var(--white);
  }
  .btn-primary:hover {
    background: var(--white);
    color: var(--black);
  }
  .btn-outline {
    background: transparent;
    color: var(--white);
    border-color: var(--white);
  }
  .btn-outline:hover {
    background: var(--white);
    color: var(--black);
  }

  .hero-image {
    position: relative;
    background-image: url('data:image/jpeg;base64,');
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }
  .hero-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10,10,10,0.5) 0%, transparent 30%, transparent 70%, rgba(232, 90, 42, 0.15) 100%);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px;
  }
  .hero-corner-tag {
    align-self: flex-end;
    background: var(--orange);
    padding: 14px 20px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-stat-block {
    background: var(--black);
    padding: 24px 28px;
    border-left: 4px solid var(--orange);
    align-self: flex-start;
    max-width: 280px;
  }
  .hero-stat-block .num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 56px;
    line-height: 1;
    color: var(--orange);
    margin-bottom: 4px;
  }
  .hero-stat-block .lbl {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--gray-300);
  }

  /* MARQUEE */
  .marquee {
    background: var(--orange);
    color: var(--white);
    padding: 22px 0;
    overflow: hidden;
    border-top: 1px solid var(--orange-dark);
    border-bottom: 1px solid var(--orange-dark);
  }
  .marquee-track {
    display: flex;
    gap: 50px;
    white-space: nowrap;
    animation: scroll 25s linear infinite;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px;
    letter-spacing: 0.06em;
  }
  .marquee-track span {
    display: inline-flex;
    align-items: center;
    gap: 50px;
  }
  .marquee-track span::after {
    content: '✦';
    font-size: 24px;
  }
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* SECTION DEFAULTS */
  section { padding: 100px 0; position: relative; }
  .section-head {
    margin-bottom: 60px;
    max-width: 800px;
  }
  .section-head.center { margin-left: auto; margin-right: auto; text-align: center; }
  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .section-tag::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--orange);
  }
  .section-tag span {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--orange);
  }
  .section-head h2 {
    font-size: clamp(44px, 6.5vw, 88px);
    line-height: 0.9;
    margin-bottom: 16px;
  }
  .section-head h2 .orange { color: var(--orange); }
  .section-head h2 .stroke {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--white);
  }
  .section-head p {
    color: var(--gray-300);
    font-size: 17px;
    max-width: 600px;
  }
  .section-head.center p { margin: 0 auto; }

  /* ABOUT */
  .about { background: var(--black); }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .about-visual {
    aspect-ratio: 4/5;
    position: relative;
    background-image: url('data:image/jpeg;base64,');
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }
  .about-visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.85) 100%);
  }
  .about-visual-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px;
  }
  .about-quote {
    align-self: flex-start;
    max-width: 85%;
  }
  .about-quote .mark {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 80px;
    line-height: 0.7;
    color: var(--orange);
    margin-bottom: 16px;
  }
  .about-quote .text {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 40px;
    line-height: 0.95;
    letter-spacing: 0.01em;
  }
  .about-quote .text .orange { color: var(--orange); }
  .about-badge {
    background: var(--orange);
    padding: 12px 20px;
    width: fit-content;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .about-text h2 {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 0.95;
    margin-bottom: 24px;
  }
  .about-text h2 .orange { color: var(--orange); }
  .about-text p {
    color: var(--gray-300);
    margin-bottom: 16px;
    font-size: 17px;
  }
  .about-list {
    list-style: none;
    margin-top: 28px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .about-list li {
    padding: 10px 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .about-list li::before {
    content: '';
    width: 8px; height: 8px;
    background: var(--orange);
    flex-shrink: 0;
    transform: rotate(45deg);
  }

  /* SERVICES */
  .services { background: var(--dark); padding: 100px 0; }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--orange);
    border: 2px solid var(--orange);
  }
  .service {
    background: var(--black);
    padding: 40px 32px;
    transition: all 0.3s;
    cursor: default;
    position: relative;
  }
  .service:hover { background: var(--orange); }
  .service:hover .service-num,
  .service:hover .service-icon,
  .service:hover h3,
  .service:hover p {
    color: var(--white);
  }
  .service-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 14px;
    color: var(--orange);
    letter-spacing: 0.15em;
    margin-bottom: 24px;
    transition: color 0.3s;
  }
  .service-icon {
    color: var(--orange);
    margin-bottom: 24px;
    transition: color 0.3s;
  }
  .service-icon svg { width: 48px; height: 48px; }
  .service h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 30px;
    margin-bottom: 12px;
    transition: color 0.3s;
  }
  .service p {
    color: var(--gray-300);
    font-size: 14px;
    line-height: 1.6;
    transition: color 0.3s;
  }

  /* POSTER CTA */
  .poster-cta {
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 520px;
  }
  .poster-left {
    background: var(--orange);
    color: var(--white);
    padding: 80px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }
  .poster-left::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(45deg, transparent 0 60px, rgba(0,0,0,0.04) 60px 61px);
    pointer-events: none;
  }
  .poster-left .tag {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    margin-bottom: 24px;
    position: relative;
  }
  .poster-left h2 {
    font-size: clamp(48px, 7vw, 88px);
    line-height: 0.9;
    margin-bottom: 24px;
    position: relative;
  }
  .poster-left p {
    font-size: 18px;
    margin-bottom: 32px;
    max-width: 440px;
    position: relative;
    font-weight: 500;
  }
  .poster-btn {
    align-self: flex-start;
    background: var(--black);
    color: var(--white);
    padding: 18px 36px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    transition: all 0.2s;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .poster-btn:hover { background: var(--white); color: var(--orange); }
  .poster-btn svg { transition: transform 0.2s; }
  .poster-btn:hover svg { transform: translateX(4px); }

  .poster-right {
    background-image: url('data:image/jpeg;base64,');
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
    min-height: 520px;
  }
  .poster-right::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0.5) 100%);
  }

  /* PRICING */
  .pricing { background: var(--black); }
  .pricing-tabs {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }
  .pricing-tab {
    background: transparent;
    border: 2px solid var(--gray-700);
    color: var(--white);
    padding: 14px 24px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.2s;
  }
  .pricing-tab:hover { border-color: var(--orange); }
  .pricing-tab.active {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--white);
  }

  .pricing-panel { display: none; }
  .pricing-panel.active { display: block; }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .pricing-grid.cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }
  .price-card {
    background: var(--dark);
    padding: 40px 28px;
    border-top: 4px solid var(--gray-700);
    position: relative;
    transition: all 0.3s;
    text-align: center;
  }
  .price-card:hover {
    border-top-color: var(--orange);
    transform: translateY(-6px);
  }
  .price-card.featured {
    background: var(--orange);
    border-top-color: var(--white);
  }
  .price-card.featured:hover { border-top-color: var(--black); }
  .price-badge {
    position: absolute;
    top: 0; right: 24px;
    background: var(--orange);
    color: var(--white);
    padding: 6px 14px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    transform: translateY(-50%);
  }
  .price-card.featured .price-badge { background: var(--black); }
  .price-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px;
    margin-bottom: 4px;
    letter-spacing: 0.02em;
  }
  .price-desc {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gray-500);
    margin-bottom: 28px;
  }
  .price-card.featured .price-desc { color: rgba(255,255,255,0.85); }
  .price-amount {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 72px;
    line-height: 0.9;
    color: var(--orange);
    margin-bottom: 4px;
  }
  .price-card.featured .price-amount { color: var(--white); }
  .price-amount sup {
    font-size: 28px;
    vertical-align: super;
    margin-right: 4px;
  }
  .price-period {
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gray-500);
    margin-bottom: 24px;
  }
  .price-card.featured .price-period { color: rgba(255,255,255,0.85); }
  .price-pp {
    font-family: 'Oswald', sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--gray-500);
    margin-bottom: 24px;
    padding-top: 8px;
    border-top: 1px solid var(--gray-900);
  }
  .price-card.featured .price-pp { color: rgba(255,255,255,0.9); border-color: rgba(255,255,255,0.2); }
  .price-pp strong { color: var(--orange); font-weight: 700; }
  .price-card.featured .price-pp strong { color: var(--white); }
  .price-btn {
    display: block;
    text-align: center;
    padding: 14px;
    background: transparent;
    border: 2px solid var(--white);
    color: var(--white);
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    transition: all 0.2s;
  }
  .price-btn:hover { background: var(--orange); border-color: var(--orange); }
  .price-card.featured .price-btn { background: var(--black); border-color: var(--black); }
  .price-card.featured .price-btn:hover { background: var(--white); border-color: var(--white); color: var(--orange); }

  .price-note {
    margin-top: 50px;
    text-align: center;
    color: var(--gray-300);
    font-size: 14px;
    padding: 20px 24px;
    background: var(--dark);
    border-left: 4px solid var(--orange);
  }
  .price-note a { color: var(--orange); font-weight: 700; }

  /* CONTACT */
  .contact { background: var(--dark); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
  }
  .contact-item {
    display: flex;
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--gray-900);
    align-items: flex-start;
  }
  .contact-item:last-of-type { border-bottom: none; }
  .contact-icon {
    width: 48px; height: 48px;
    background: var(--orange);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .contact-icon svg { width: 20px; height: 20px; }
  .contact-item-label {
